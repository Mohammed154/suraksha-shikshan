# Copy this file to .env and fill in your real values
# NEVER commit .env to git

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdefgh

# Google Safe Browsing API key (used in Firebase Function, NOT in frontend)
SAFE_BROWSING_API_KEY=your_google_safe_browsing_key

# WhoisXML API key (used in Firebase Function, NOT in frontend)
WHOIS_API_KEY=your_whoisxml_api_key
